module target_selector (
    input  wire [3:0] reqs,
    input  wire [1:0] current_floor,
    input  wire       dir_up,
    output reg  [1:0] target,
    output reg        valid
);
    integer i;
    reg [1:0] best_up, best_down;
    reg found_up, found_down;
 always @(*) begin
        valid      = 0;
        target     = current_floor;
        found_up   = 0;
        found_down = 0;
        best_up    = 0;
        best_down  = 0;

        // nearest above
        for (i = 0; i < 4; i = i + 1)
            if (reqs[i] && (i > current_floor) && !found_up) begin
                best_up = i[1:0]; found_up = 1;
            end

        // nearest below
        for (i = 3; i >= 0; i = i - 1)
            if (reqs[i] && (i < current_floor) && !found_down) begin
                best_down = i[1:0]; found_down = 1;
            end

        if (dir_up && found_up) begin
            target = best_up; valid = 1;
        end else if (!dir_up && found_down) begin
            target = best_down; valid = 1;
        end else if (found_up) begin
            target = best_up; valid = 1;
        end else if (found_down) begin
            target = best_down; valid = 1;
        end
    end
endmodule
